#!/usr/bin/env bash
# Local helper: copy a built APK to an AREDN node over SSH and install it.
# Not intended for source control — see install_package_remotely.conf for defaults.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONF="${SCRIPT_DIR}/install_package_remotely.conf"

# Env SSH_PASSWORD overrides conf; capture before defaults/source overwrite it.
_ENV_SSH_PASSWORD_SET=0
if [[ -n "${SSH_PASSWORD+x}" ]]; then
    _ENV_SSH_PASSWORD_SET=1
    _ENV_SSH_PASSWORD="${SSH_PASSWORD}"
fi

SSH_PORT=2222
SSH_USER=root
SSH_PASSWORD=""
PACKAGE_PATH=""
PACKAGE_ARG=""
NODE=""
REMOTE_DIR="/tmp"
QUIET=0

usage() {
    cat <<EOF
Usage: $(basename "$0") [-apk packagename] [-node nodename[,nodename...]] [-q]

  -apk packagename
               Path to a .apk, a package basename, or a short name such as
               aredn-terminal (finds newest aredn-terminal-*.apk under PACKAGE_PATH).
               If omitted, the newest *.apk under PACKAGE_PATH is used.
  -node nodename[,nodename...]
               DNS name or IP of the AREDN node, or a comma-separated list of
               nodes (or set NODE in config). Whitespace around commas is ignored.
  -q           Quiet mode (off by default). Suppresses progress output.

Defaults may be set in:
  ${CONF}

  PACKAGE_PATH   Directory of locally built .apk files
  NODE           Default node address (comma-separated list allowed)
  SSH_PASSWORD   Optional password for SSH/SCP (requires sshpass).
                 Exported env SSH_PASSWORD overrides conf
                 (e.g. SSH_PASSWORD=secret ./install_package_remotely).
                 When set, key auth is disabled; password auth only.

SSH/SCP use port ${SSH_PORT} and scp -O.
EOF
}

log() {
    if [[ "${QUIET}" -eq 0 ]]; then
        printf '%s\n' "$*"
    fi
}

# Run a step; print start/success/failure unless quiet. Returns status (does not exit).
run_step() {
    local desc="$1"
    shift
    local rc=0
    log "Step: ${desc} ..."
    "$@" || rc=$?
    if [[ "${rc}" -eq 0 ]]; then
        log "  OK: ${desc}"
        return 0
    fi
    echo "  FAIL: ${desc} (exit ${rc})" >&2
    return "${rc}"
}

# Newest matching file in dir by mtime. pattern is a find -name glob (e.g. '*.apk').
newest_apk() {
    local dir="$1"
    local pattern="$2"
    find "${dir}" -maxdepth 1 -type f -name "${pattern}" -printf '%T@\t%p\n' 2>/dev/null \
        | sort -nr \
        | head -n1 \
        | cut -f2-
}

resolve_package() {
    local arg="${1:-}"

    if [[ -n "${arg}" && -f "${arg}" ]]; then
        printf '%s\n' "${arg}"
        return 0
    fi

    if [[ -z "${PACKAGE_PATH}" ]]; then
        echo "error: no package file given and PACKAGE_PATH is not set in ${CONF}" >&2
        return 1
    fi
    if [[ ! -d "${PACKAGE_PATH}" ]]; then
        echo "error: PACKAGE_PATH is not a directory: ${PACKAGE_PATH}" >&2
        return 1
    fi

    local found=""
    if [[ -z "${arg}" ]]; then
        found="$(newest_apk "${PACKAGE_PATH}" '*.apk')"
        if [[ -z "${found}" ]]; then
            echo "error: no .apk files found in ${PACKAGE_PATH}" >&2
            return 1
        fi
    elif [[ "${arg}" == *.apk && -f "${PACKAGE_PATH}/${arg}" ]]; then
        found="${PACKAGE_PATH}/${arg}"
    elif [[ "${arg}" == *.apk ]]; then
        found="$(newest_apk "${PACKAGE_PATH}" "${arg}")"
        if [[ -z "${found}" ]]; then
            echo "error: package not found: ${arg} (also checked under ${PACKAGE_PATH})" >&2
            return 1
        fi
    else
        # Short name, e.g. aredn-terminal -> aredn-terminal-0.1.11-r0.apk
        found="$(newest_apk "${PACKAGE_PATH}" "${arg}-*.apk")"
        if [[ -z "${found}" ]]; then
            echo "error: no packages matching '${arg}-*.apk' in ${PACKAGE_PATH}" >&2
            return 1
        fi
    fi

    printf '%s\n' "${found}"
}

# Split comma-separated node list into NODES array (trim whitespace; skip empties).
parse_nodes() {
    local raw="$1"
    NODES=()
    local IFS=','
    local part
    # shellcheck disable=SC2086
    for part in ${raw}; do
        # Trim leading/trailing whitespace
        part="${part#"${part%%[![:space:]]*}"}"
        part="${part%"${part##*[![:space:]]}"}"
        if [[ -n "${part}" ]]; then
            NODES+=("${part}")
        fi
    done
}

# Install PACKAGE to a single node. Uses globals: SSH_USER, SSH_PORT, REMOTE_*, PKG_*, REMOTE_PREFIX, SSH_OPTS, SCP_OPTS.
install_to_node() {
    local node="$1"
    local ssh_target="${SSH_USER}@${node}"
    local rc=0

    log "Node:    ${node} (${ssh_target}, port ${SSH_PORT})"
    log ""

    run_step "copy package to node (${REMOTE_PATH})" \
        "${REMOTE_PREFIX[@]}" scp "${SCP_OPTS[@]}" "${PACKAGE}" "${ssh_target}:${REMOTE_PATH}" || return $?

    # Removal may fail if not installed; treat that as success.
    log "Step: remove existing package '${PKG_NAME}' (if present) ..."
    if "${REMOTE_PREFIX[@]}" ssh "${SSH_OPTS[@]}" "${ssh_target}" "apk del '${PKG_NAME}'" >/dev/null 2>&1; then
        log "  OK: remove existing package '${PKG_NAME}'"
    else
        log "  OK: remove existing package '${PKG_NAME}' (not installed or already removed)"
    fi

    run_step "install package on node" \
        "${REMOTE_PREFIX[@]}" ssh "${SSH_OPTS[@]}" "${ssh_target}" "apk add --allow-untrusted --no-network '${REMOTE_PATH}'" || return $?

    run_step "remove temporary package file on node" \
        "${REMOTE_PREFIX[@]}" ssh "${SSH_OPTS[@]}" "${ssh_target}" "rm -f '${REMOTE_PATH}'" || return $?

    return 0
}

if [[ -f "${CONF}" ]]; then
    # shellcheck disable=SC1090
    source "${CONF}"
fi

if [[ "${_ENV_SSH_PASSWORD_SET}" -eq 1 ]]; then
    SSH_PASSWORD="${_ENV_SSH_PASSWORD}"
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -q)
            QUIET=1
            shift
            ;;
        -apk)
            if [[ $# -lt 2 || "$2" == -* ]]; then
                echo "error: -apk requires a package name or path" >&2
                exit 1
            fi
            PACKAGE_ARG="$2"
            shift 2
            ;;
        -node)
            if [[ $# -lt 2 || "$2" == -* ]]; then
                echo "error: -node requires a node DNS name or IP (comma-separated list allowed)" >&2
                exit 1
            fi
            NODE="$2"
            shift 2
            ;;
        *)
            echo "error: unknown argument: $1" >&2
            usage
            exit 1
            ;;
    esac
done

if [[ -z "${NODE}" ]]; then
    usage
    echo "error: node is required (-node or NODE in ${CONF})" >&2
    exit 1
fi

parse_nodes "${NODE}"
if [[ "${#NODES[@]}" -eq 0 ]]; then
    echo "error: -node / NODE produced an empty node list" >&2
    exit 1
fi

log "Step: identify package ..."
PACKAGE="$(resolve_package "${PACKAGE_ARG}")" || {
    echo "  FAIL: identify package" >&2
    exit 1
}
log "  OK: identify package"

PKG_BASENAME="$(basename "${PACKAGE}")"
if [[ "${PKG_BASENAME}" != *.apk ]]; then
    echo "error: expected an .apk file, got: ${PKG_BASENAME}" >&2
    exit 1
fi

# Prefer pkgname from the APK metadata; fall back to filename without .apk
PKG_NAME="$(tar -xOf "${PACKAGE}" .PKGINFO 2>/dev/null | sed -n 's/^pkgname = //p' | head -n1 || true)"
if [[ -z "${PKG_NAME}" ]]; then
    PKG_NAME="${PKG_BASENAME%.apk}"
    if [[ "${QUIET}" -eq 0 ]]; then
        echo "warning: could not read .PKGINFO; using '${PKG_NAME}' for apk del" >&2
    fi
fi

REMOTE_PATH="${REMOTE_DIR}/${PKG_BASENAME}"
# accept-new: first contact stores the key; still fails if a known key changes.
SSH_OPTS=(-p "${SSH_PORT}" -o StrictHostKeyChecking=accept-new)
SCP_OPTS=(-O -P "${SSH_PORT}" -o StrictHostKeyChecking=accept-new)
REMOTE_PREFIX=()

if [[ -n "${SSH_PASSWORD}" ]]; then
    if ! command -v sshpass >/dev/null 2>&1; then
        echo "error: SSH_PASSWORD is set but sshpass is not installed" >&2
        echo "hint: install sshpass, or unset SSH_PASSWORD / clear it in ${CONF}" >&2
        exit 1
    fi
    export SSHPASS="${SSH_PASSWORD}"
    REMOTE_PREFIX=(sshpass -e)
    # Password mode: do not attempt key/agent auth.
    SSH_OPTS+=(-o PubkeyAuthentication=no -o PreferredAuthentications=password -o PasswordAuthentication=yes)
    SCP_OPTS+=(-o PubkeyAuthentication=no -o PreferredAuthentications=password -o PasswordAuthentication=yes)
fi

log "Package: ${PKG_BASENAME}"
log "  path:  ${PACKAGE}"
log "  name:  ${PKG_NAME}"
if [[ "${#NODES[@]}" -gt 1 ]]; then
    log "Nodes:   ${NODES[*]} (${#NODES[@]} targets)"
else
    log "Nodes:   ${NODES[0]}"
fi
log ""

FAILED_NODES=()
SUCCEEDED_NODES=()
for node in "${NODES[@]}"; do
    if [[ "${#NODES[@]}" -gt 1 ]]; then
        log "=== ${node} ==="
    fi
    if install_to_node "${node}"; then
        SUCCEEDED_NODES+=("${node}")
        log "Done: ${node}"
    else
        FAILED_NODES+=("${node}")
        echo "error: install failed on ${node}" >&2
    fi
    log ""
done

if [[ "${#NODES[@]}" -gt 1 ]]; then
    log "Summary: ${#SUCCEEDED_NODES[@]} succeeded, ${#FAILED_NODES[@]} failed (of ${#NODES[@]})"
    if [[ "${#SUCCEEDED_NODES[@]}" -gt 0 ]]; then
        log "  OK:   ${SUCCEEDED_NODES[*]}"
    fi
    if [[ "${#FAILED_NODES[@]}" -gt 0 ]]; then
        echo "  FAIL: ${FAILED_NODES[*]}" >&2
    fi
fi

if [[ "${#FAILED_NODES[@]}" -gt 0 ]]; then
    exit 1
fi

log "Done."
