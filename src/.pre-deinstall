#!/bin/sh
# Stop and disable babel-monitord before package removal.
. /usr/share/babel_monitor/defer-ring.sh 2>/dev/null || true
if type bm_cancel_deferred_ring >/dev/null 2>&1; then
	bm_cancel_deferred_ring
fi
rm -f /tmp/babel-monitor-defer-ring 2>/dev/null || true
[ -x /etc/init.d/babel-monitor ] && /etc/init.d/babel-monitor stop 2>/dev/null || true
[ -x /etc/init.d/babel-monitor ] && /etc/init.d/babel-monitor disable 2>/dev/null || true
rm -f /var/run/babel-monitor.sock /var/run/babel-monitor.pid 2>/dev/null || true
exit 0
